<Window x:Class="FreshWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FreshWin"
        Width="1240" Height="820" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================== custom title bar -->
        <Grid Grid.Row="0" Background="{StaticResource SidebarBg}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource AccentGradient}">
                    <Path Data="M8 4v6.5 M5.2 8.2 8 11l2.8-2.8 M4.5 12.6h7"
                          Stroke="White" StrokeThickness="1.4" Stretch="Uniform" Margin="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <TextBlock Text="FreshWin" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarHint" Margin="10,0,0,0" FontSize="11.5"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource ChromeButton}" Click="Minimise_Click" ToolTip="Minimise">
                    <Path Data="M0,0 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="Maximise_Click" ToolTip="Maximise">
                    <Path Data="M0.5,0.5 H10.5 V10.5 H0.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
                <Button Style="{StaticResource CloseChromeButton}" Click="Close_Click" ToolTip="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== page: pick -->
        <Grid x:Name="PickPage" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="SOFTWARE" Margin="20,18,0,10" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                            <ListBox x:Name="CategoryList" Margin="10,0,10,0"
                                     Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding Categories}"
                                     ItemContainerStyle="{StaticResource CategoryItem}"
                                     SelectionChanged="CategoryList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <TextBlock Text="TUNE WINDOWS" Margin="20,20,0,10" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                            <ListBox x:Name="GroupList" Margin="10,0,10,0"
                                     Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding Groups}"
                                     ItemContainerStyle="{StaticResource CategoryItem}"
                                     SelectionChanged="GroupList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <TextBlock Text="REMOVE" Margin="20,20,0,10" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                            <ListBox x:Name="BloatList" Margin="10,0,10,10"
                                     Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding BloatGroups}"
                                     ItemContainerStyle="{StaticResource CategoryItem}"
                                     SelectionChanged="BloatList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="18,14">
                        <StackPanel>
                            <TextBlock x:Name="EngineStatus" Style="{StaticResource Subtle}"
                                       Text="Checking winget…" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Text="Installs run through the Windows Package Manager." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- main column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- heading + toolbars -->
                <Grid Grid.Row="0" Margin="28,22,28,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource H1}" Text="{Binding PaneTitle}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                   Text="{Binding PaneSubtitle}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchInput" Grid.Column="0" Height="38" MaxWidth="380"
                                 HorizontalAlignment="Left" MinWidth="220"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="SearchInput_TextChanged" />

                        <!-- software preset chips -->
                        <StackPanel x:Name="SoftwareTools" Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ChipButton}" Click="Essentials_Click"
                                    ToolTip="Tick the apps almost every PC wants">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8 1.5 L9.59 5.82 L14.18 5.99 L10.57 8.83 L11.82 13.26 L8 10.7 L4.18 13.26 L5.43 8.83 L1.82 5.99 L6.41 5.82 Z"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.3" Width="13" Height="13"
                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="Essentials" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Select all shown" Click="SelectAllShown_Click" />
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Clear" Click="ClearPane_Click" />
                            <Button x:Name="ScanButton" Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Clone this PC" Click="CloneThisPc_Click"
                                    ToolTip="Read what is installed here and save it as a profile" />
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Load profile" Click="LoadProfile_Click" />
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Save selection" Click="SaveProfile_Click" />
                        </StackPanel>

                        <!-- tweak preset chips -->
                        <StackPanel x:Name="TweakTools" Grid.Column="1" Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button Style="{StaticResource ChipButton}" Click="RecommendedTweaks_Click"
                                    ToolTip="Tick the settings that are safe wins on any PC">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8 1.5 L9.59 5.82 L14.18 5.99 L10.57 8.83 L11.82 13.26 L8 10.7 L4.18 13.26 L5.43 8.83 L1.82 5.99 L6.41 5.82 Z"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.3" Width="13" Height="13"
                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="Recommended" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Select all shown" Click="SelectAllShown_Click" />
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Clear" Click="ClearPane_Click" />
                            <Button x:Name="UndoButton" Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Click="UndoTweaks_Click"
                                    ToolTip="Put back everything the last run changed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 8a5 5 0 1 0 5-5H4.5 M3 3v4h4"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"
                                          VerticalAlignment="Center" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <TextBlock Text="Undo last run" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- removal preset chips -->
                        <StackPanel x:Name="BloatTools" Grid.Column="1" Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button Style="{StaticResource ChipButton}" Click="RecommendedBloat_Click"
                                    ToolTip="Tick the preinstalled apps almost nobody misses">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8 1.5 L9.59 5.82 L14.18 5.99 L10.57 8.83 L11.82 13.26 L8 10.7 L4.18 13.26 L5.43 8.83 L1.82 5.99 L6.41 5.82 Z"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.3" Width="13" Height="13"
                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="Recommended" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Select all shown" Click="SelectAllShown_Click" />
                            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                    Content="Clear" Click="ClearPane_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- warning banner -->
                <Border x:Name="Banner" Grid.Row="1" Margin="28,0,28,14" Padding="14,12" CornerRadius="10"
                        Background="#241E12" BorderBrush="#4A3A1A" BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0"
                              VerticalAlignment="Center"
                              Data="M12 3l9 16H3z M12 9v5 M12 16.4v.2"
                              Stroke="{StaticResource Warn}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock x:Name="BannerText" Grid.Column="1" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="#E9D6AE" TextWrapping="Wrap" />
                        <Button x:Name="BannerAction" Grid.Column="2" Style="{StaticResource ChipButton}"
                                Margin="12,0,0,0" Visibility="Collapsed" Click="BannerAction_Click" />
                    </Grid>
                </Border>

                <!-- ======================================================= app grid -->
                <ScrollViewer x:Name="AppScroller" Grid.Row="2" Margin="20,0,14,0" Padding="8,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding VisibleApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="282" ItemHeight="112" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AppCard}" Margin="0,0,10,10"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                    Width="38" Height="38" CornerRadius="10"
                                                    Background="{Binding Accent}" VerticalAlignment="Top"
                                                    Margin="0,0,11,0">
                                                <TextBlock Text="{Binding Initials}" Foreground="White"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                                        Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Publisher}" FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource EssentialPill}" Margin="7,0,0,0">
                                                    <TextBlock Text="essential" FontSize="9.5"
                                                               Foreground="#9DB8FF" />
                                                </Border>
                                                <Border Style="{StaticResource StorePill}" Margin="5,0,0,0">
                                                    <TextBlock Text="store" FontSize="9.5"
                                                               Foreground="#BDA6FF" />
                                                </Border>
                                                <Border Style="{StaticResource InstalledPill}" Margin="5,0,0,0">
                                                    <TextBlock Text="installed" FontSize="9.5"
                                                               Foreground="#8FE3B8" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding Description}" Margin="0,7,0,0"
                                                       FontSize="11.5" LineHeight="15" MaxHeight="32"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top" />

                                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TickBox}">
                                                <Path Data="M3.2 7.2l2.6 2.6 5-5.4" Stroke="White"
                                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Style="{StaticResource TickMark}" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Subtle}" Margin="6,30,0,0"
                                   Visibility="Collapsed" Text="Nothing matches that search." />
                    </Grid>
                </ScrollViewer>

                <!-- ===================================================== tweak grid -->
                <ScrollViewer x:Name="TweakScroller" Grid.Row="2" Margin="20,0,14,0" Padding="8,0"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding VisibleTweaks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="316" ItemHeight="150" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AppCard}" Margin="0,0,10,10"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding Subtitle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                    Width="38" Height="38" CornerRadius="10"
                                                    Background="{Binding Accent}" VerticalAlignment="Top"
                                                    Margin="0,0,11,0">
                                                <TextBlock Text="{Binding Initials}" Foreground="White"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />

                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                                        Margin="0,3,0,0">
                                                <Border Style="{StaticResource OnPill}">
                                                    <TextBlock Text="already on" FontSize="9.5"
                                                               Foreground="#8FE3B8" />
                                                </Border>
                                                <Border Style="{StaticResource AdminPill}" Margin="5,0,0,0">
                                                    <TextBlock Text="admin" FontSize="9.5"
                                                               Foreground="#E9C889" />
                                                </Border>
                                                <Border Style="{StaticResource Win11Pill}" Margin="5,0,0,0">
                                                    <TextBlock Text="Windows 11" FontSize="9.5"
                                                               Foreground="#9AA2B8" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding Description}" Margin="0,7,0,0"
                                                       FontSize="11.5" LineHeight="15" MaxHeight="62"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top" />

                                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TickBox}">
                                                <Path Data="M3.2 7.2l2.6 2.6 5-5.4" Stroke="White"
                                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Style="{StaticResource TickMark}" />
                                            </Border>

                                            <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Style="{StaticResource RevertLink}"
                                                    HorizontalAlignment="Right" Margin="0,4,0,0"
                                                    Click="RevertTweak_Click" Tag="{Binding}"
                                                    ToolTip="Set this back to the Windows default">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M3 8a5 5 0 1 0 5-5H4.5 M3 3v4h4"
                                                          Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="1.3" Width="12" Height="12"
                                                          Stretch="Uniform" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock Text="revert" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyTweakHint" Style="{StaticResource Subtle}" Margin="6,30,0,0"
                                   Visibility="Collapsed" Text="Nothing matches that search." />
                    </Grid>
                </ScrollViewer>

                <!-- ===================================================== bloat grid -->
                <ScrollViewer x:Name="BloatScroller" Grid.Row="2" Margin="20,0,14,0" Padding="8,0"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding VisibleBloat}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="316" ItemHeight="146" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AppCard}" Margin="0,0,10,10"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding PackageName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                    Width="38" Height="38" CornerRadius="10"
                                                    Background="{Binding Accent}" VerticalAlignment="Top"
                                                    Margin="0,0,11,0">
                                                <TextBlock Text="{Binding Initials}" Foreground="White"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />

                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                                        Margin="0,3,0,0">
                                                <Border Style="{StaticResource PresentPill}">
                                                    <TextBlock Text="on this PC" FontSize="9.5"
                                                               Foreground="#E9C889" />
                                                </Border>
                                                <Border Style="{StaticResource GonePill}">
                                                    <TextBlock Text="not installed" FontSize="9.5"
                                                               Foreground="{StaticResource TextMuted}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding Description}" Margin="0,7,0,0"
                                                       FontSize="11.5" LineHeight="15" MaxHeight="47"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top" />

                                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TickBox}">
                                                <Path Data="M3.2 7.2l2.6 2.6 5-5.4" Stroke="White"
                                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Style="{StaticResource TickMark}" />
                                            </Border>

                                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                        Orientation="Horizontal" Margin="0,5,0,0">
                                                <Path Data="M8 2l6 11H2z M8 6.5v3.5 M8 11.4v.2"
                                                      Stroke="#E9C889" StrokeThickness="1.3" Width="12" Height="12"
                                                      Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                      Style="{StaticResource CautionIcon}" />
                                                <TextBlock Text="{Binding Caution}" VerticalAlignment="Center"
                                                           Style="{StaticResource CautionNote}" />
                                            </StackPanel>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyBloatHint" Style="{StaticResource Subtle}" Margin="6,30,0,0"
                                   Visibility="Collapsed" Text="Nothing matches that search." />
                    </Grid>
                </ScrollViewer>

                <!-- footer -->
                <Border Grid.Row="3" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="28,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionHeadline}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding SelectionDetail}" Style="{StaticResource Subtle}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button x:Name="NextButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Click="Next_Click" IsEnabled="{Binding HasSelection}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RunButtonText}" VerticalAlignment="Center" />
                                <Path Data="M0 6h11 M6.5 1.5L11 6l-4.5 4.5" Stroke="White" StrokeThickness="1.6"
                                      Margin="10,0,0,0" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= page: run -->
        <Grid x:Name="RunPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,10">
                <TextBlock x:Name="RunHeadline" Style="{StaticResource H1}" Text="Working…" />
                <TextBlock x:Name="RunSubtitle" Style="{StaticResource Subtle}" Margin="0,4,0,0"
                           Text="Leave this window open. Each item is handled one after another." />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- ProgressBar.Value binds TwoWay by default, which a read-only
                         view-model property cannot satisfy. -->
                    <ProgressBar Grid.Column="0" Style="{StaticResource ThinProgressBar}"
                                 VerticalAlignment="Center" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding ProgressText}"
                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24,8,18,0" Padding="8,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RunQueue}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Background="{StaticResource CardBg}"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    Padding="14,11" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,13,0"
                                          VerticalAlignment="Center">
                                        <Ellipse Stroke="#333B4E" StrokeThickness="1.6" Width="18" Height="18"
                                                 Style="{StaticResource NeutralRing}" />

                                        <Path Data="M12 3a9 9 0 0 1 9 9" Stroke="{StaticResource Accent}"
                                              StrokeThickness="2.2" Width="20" Height="20" Stretch="Uniform"
                                              StrokeStartLineCap="Round" RenderTransformOrigin="0.5,0.5"
                                              Style="{StaticResource BusySpinner}">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <Path Data="M4 12.5l5 5 11-11" Stroke="{StaticResource Good}"
                                              StrokeThickness="2.2" Width="18" Height="18" Stretch="Uniform"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Style="{StaticResource GoodMark}" />

                                        <Path Data="M12 3v13 M12 19.5v.5" Stroke="{StaticResource Warn}"
                                              StrokeThickness="2.2" Width="18" Height="18" Stretch="Uniform"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Style="{StaticResource WarnMark}" />

                                        <Path Data="M5 5l14 14 M19 5L5 19" Stroke="{StaticResource Bad}"
                                              StrokeThickness="2.2" Width="16" Height="16" Stretch="Uniform"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Style="{StaticResource BadMark}" />
                                    </Grid>

                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8"
                                            Background="{Binding Accent}" Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11.5"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0,2,0"
                                               TextAlignment="Right" Style="{StaticResource StatusLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="LogPanel" Grid.Row="2" Margin="32,14,32,0" CornerRadius="10"
                    Background="#0A0C12" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    Height="150" Visibility="Collapsed">
                <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         Foreground="#8A93A8" FontFamily="{StaticResource MonoFont}" FontSize="11"
                         Padding="12,10" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Border>

            <Border Grid.Row="3" Background="{StaticResource PanelBg}" Margin="0,16,0,0"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LogToggle" Grid.Column="0" Style="{StaticResource ChipButton}"
                            Content="Show details" Click="LogToggle_Click" VerticalAlignment="Center" />

                    <TextBlock x:Name="SummaryText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                               Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}"
                                Content="Stop after current" Click="Stop_Click" VerticalAlignment="Center" />
                        <Button x:Name="RestartExplorerButton" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Content="Restart Explorer" Click="RestartExplorer_Click"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="Needed before the Explorer and taskbar changes show up" />
                        <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Content="Back to list" Click="Back_Click" VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        <Button x:Name="FinishButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Content="Done" Click="Close_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
