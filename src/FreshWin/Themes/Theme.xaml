<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ palette -->
    <Color x:Key="AccentColor">#4C7DF0</Color>
    <Color x:Key="AccentColor2">#7C5CF0</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#0E1017" />
    <SolidColorBrush x:Key="SidebarBg" Color="#12141C" />
    <SolidColorBrush x:Key="PanelBg" Color="#151824" />
    <SolidColorBrush x:Key="CardBg" Color="#181C28" />
    <SolidColorBrush x:Key="CardHoverBg" Color="#1F2432" />
    <SolidColorBrush x:Key="CardSelectedBg" Color="#1B2440" />
    <SolidColorBrush x:Key="Hairline" Color="#232838" />
    <SolidColorBrush x:Key="HairlineStrong" Color="#2E3446" />

    <SolidColorBrush x:Key="TextPrimary" Color="#EDEFF5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA2B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#6C7488" />
    <SolidColorBrush x:Key="Accent" Color="#4C7DF0" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2A3A6B" />
    <SolidColorBrush x:Key="Good" Color="#3DD68C" />
    <SolidColorBrush x:Key="Warn" Color="#F2B94B" />
    <SolidColorBrush x:Key="Bad" Color="#FF6B6B" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C7DF0" Offset="0" />
        <GradientStop Color="#7C5CF0" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ========================================================= scrollbars -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#2C3243" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3D4559" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              Focusable="False" IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              Focusable="False" IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"
                                                      Focusable="False" IsTabStop="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"
                                                      Focusable="False" IsTabStop="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource AccentGradient}">
                        <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2230" />
                            <Setter Property="Foreground" Value="#5A6176" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                            BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1D2230" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="13,7" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#7FA3FF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#232838" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= search box -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="#12151F" CornerRadius="9"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center"
                                  Data="M10.5 10.5a4.5 4.5 0 1 0-9 0 4.5 4.5 0 0 0 9 0z M10 10l4 4"
                                  Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="Placeholder" Text="Search all apps…" Margin="0,0,12,0"
                                           Foreground="#5F6678" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,12,0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== category navbar -->
    <Style x:Key="CategoryItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="Ico" Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                  Margin="0,0,11,0" VerticalAlignment="Center"
                                  Data="{Binding Icon}" Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                            <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Name}"
                                       Foreground="{StaticResource TextSecondary}" FontSize="13.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <Border x:Name="Badge" Grid.Column="2" CornerRadius="9" MinWidth="22" Height="18"
                                    Background="#1E2434" VerticalAlignment="Center" Padding="6,0">
                                <TextBlock x:Name="BadgeText" Text="{Binding BadgeLabel}" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A1F2C" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2740" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Ico" Property="Stroke" Value="#8FB0FF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                            <Setter TargetName="BadgeText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================== app card -->
    <Style x:Key="AppCard" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="14,13">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardSelectedBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================= progress bar -->
    <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#1A1F2C" CornerRadius="3">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}" CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================= misc helpers -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="Subtle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- ============================================================== pills -->
    <Style x:Key="PillBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="EssentialPill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#22305A" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Essential}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StorePill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#2A2440" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFromStore}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OnPill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#16342A" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowAsOn}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AdminPill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#38290F" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RequiresAdmin}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Win11Pill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#22262F" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Windows11Only}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================== card tick box -->
    <Style x:Key="TickBox" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="BorderBrush" Value="#394054" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TickMark" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RevertLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="7,3"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#232838" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowAsOn}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================== run status glyphs -->
    <Style x:Key="NeutralRing" TargetType="Ellipse">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Neutral">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BusySpinner" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="Spin">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GoodMark" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Good">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WarnMark" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Warn">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BadMark" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Bad">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="Good">
                <Setter Property="Foreground" Value="{StaticResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="Bad">
                <Setter Property="Foreground" Value="{StaticResource Bad}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InstalledPill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#16342A" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PresentPill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#38290F" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowAsPresent}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GonePill" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="#1B1F2B" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowAsGone}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CautionNote" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#E9C889" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasCaution}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CautionIcon" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasCaution}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
